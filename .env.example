# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
# Optional, defaults to ./data (database, uploads and logs go here)
# DATA_DIR=./data
# Optional upload limits (every upload costs a Gemini call)
# UPLOADS_PER_IP_PER_HOUR=10
# UPLOADS_PER_DAY=200
# Optional Gemini model, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-3.8-flash
# Optional: 0 turns off the background worker (no receipts read, no flyers fetched)
# RUN_WORKER=1
# Optional: hours between flyer fetches from eTilbudsavis, 0 turns it off
# FLYER_REFRESH_HOURS=6
# Optional: days uploaded receipt files (PDF, CSV, JSON) are kept, for improving the reading
# KEEP_FILES_DAYS=365
