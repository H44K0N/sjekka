# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key
# Optional, defaults to ./data (database, uploads and logs go here)
# DATA_DIR=./data
# Optional upload limits (every upload costs a Gemini call)
# UPLOADS_PER_IP_PER_HOUR=10
# UPLOADS_PER_DAY=200
# Optional Gemini model, defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-3.8-flash
